# Copia este archivo como .env para sobrescribir los valores por defecto.
# Sin .env, `docker compose up` funciona igual con los valores de desarrollo.

POSTGRES_USER=practicas
POSTGRES_PASSWORD=practicas
POSTGRES_DB=practicas

JWT_SECRET=dev-secret-cambiar-en-produccion
JWT_EXPIRACION_MINUTOS=480
CORS_ORIGENES=http://localhost:5173

# Administrador creado por el seed (no es registrable desde el formulario).
SEED_ADMIN_CORREO=admin@universidad.cl
SEED_ADMIN_PASSWORD=admin123
